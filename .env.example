# Copy to .env and fill in. Never commit .env.
# Values marked PENDING are waiting on a team decision (see PENDING.md).

# --- Database (Supabase) -----------------------------------------------------
# Workers connect directly to Postgres. In Supabase: Project Settings → Database
# → Connection string → URI (use the session pooler on IPv4-only networks).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Server-only. Bypasses row-level security. NEVER expose to the browser or
# prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Safe for the browser (RLS applies). Used by the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Embeddings --------------------------------------------------------------
# PENDING: model/dimension to agree with Aolin.
#   fake   — deterministic offline vectors for wiring/tests only (meaningless similarity)
#   voyage — Voyage AI (Anthropic's recommended embedding provider)
#   openai — OpenAI embeddings
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=voyage-3.5
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Claude (brand-fit check, outreach drafts, weekly brief) -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# llm = use Claude; template = deterministic placeholder text (no key needed).
# Unset: llm when ANTHROPIC_API_KEY is set, otherwise template.
AI_MODE=
# Server-side refusal fallback (default) or off.
LLM_FALLBACKS=default

# --- Seed data ---------------------------------------------------------------
# Folder holding Aolin's CSVs. Defaults to the example data until the real files arrive.
SEED_DIR=seed/example

# --- API server (python -m uvicorn feng_workers.api:app) ------------------------
# PENDING (D1): dev = no sign-in, user from DEV_* below (local only!);
#               supabase = Bearer session token + profiles table.
AUTH_MODE=dev
# Required whenever the API is reachable online in dev mode: clients must send
# header X-Dev-Key with this value. Leave empty for local-only use.
DEV_ACCESS_KEY=
DEV_ROLE=admin
DEV_LOCATIONS=sunnyvale
SUPABASE_ANON_KEY=
# Shows the demo tools (simulate, generate brief) to admins.
DEMO_MODE=true
# Frontend origins allowed to call the API (comma-separated). PENDING: Tyler's URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
